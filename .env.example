# Copy to .env (gitignored). Every key is read by pydantic-settings with prefix PUMPGROK_.
# Nested keys use double underscore: PUMPGROK_RISK__MAX_TRADES_PER_DAY maps to risk.max_trades_per_day.
# All values here are placeholders: this file must pass the secrets gate.

PUMPGROK_PROFILE=paper                      # dev | paper | live ; selects src/pumpgrok/config/overlays/<profile>.toml
PUMPGROK_CONFIG=                            # optional operator overlay TOML applied last; empty = none
PUMPGROK_MODE=paper                         # paper | live ; precedence CLI --mode > PUMPGROK_MODE > TOML execution.mode

# Risk overrides (optional; overlay defaults apply when unset)
PUMPGROK_RISK__MAX_TRADES_PER_DAY=20

# Replay
PUMPGROK_REPLAY__SEED=20260101              # the one SEED name the loader allows

# Live gate: not built yet. Effective mode live is refused at startup.
PUMPGROK_LIVE__ENABLED=false

# x.ai Grok secret (env only, never TOML). Empty = Grok agents report not configured.
PUMPGROK_GROK__API_KEY=

# Jupiter optional key (NOT a PUMPGROK_ setting): read once in the composition
# root and sent as x-api-key. Empty or unset = keyless quote. Example:
# JUPITER_API_KEY=

# Paper desk. Empty RPC uses the public Solana endpoint. Empty keys mean keyless public reads.
# Do not put a key inside a URL. Jupiter quote URL stays at the code default unless overridden
# by a keyless https endpoint in the process environment.
PUMPGROK_DESK__STARTING_USD=1000
PUMPGROK_DESK__ORDER_USD=20
PUMPGROK_DESK__STOP_BPS=2500
PUMPGROK_DESK__TP1_BPS=5000
PUMPGROK_DESK__TP2_BPS=10000
PUMPGROK_DESK__FEE_BPS=30
PUMPGROK_DESK__SLIPPAGE_BPS=100
PUMPGROK_DESK__POOL_CAP_BPS=200
PUMPGROK_DESK__STALE_SECONDS=10
PUMPGROK_DESK__WHALE_MAX_PCT=10
PUMPGROK_DESK__POLL_SECONDS=10
PUMPGROK_DESK__RPC_URL=
PUMPGROK_DESK__JUPITER_API_KEY=
PUMPGROK_DESK__RUGCHECK_API_KEY=
PUMPGROK_DESK__FIXTURE=
PUMPGROK_DESK__JOURNAL=

# FORBIDDEN: the loader refuses to start if any of these names is present in the environment,
# with or without the PUMPGROK_ prefix. The only exemption is PUMPGROK_REPLAY__SEED above.
#   PRIVATE_KEY  SECRET_KEY  SEED  MNEMONIC  PHANTOM  WALLET_SECRET
#   WALLET_PRIVATE_KEY  KEYPAIR  SOLANA_PRIVATE_KEY
